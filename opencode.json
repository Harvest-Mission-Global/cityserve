{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "rm -rf*": "ask",
      "npm *": "deny",
      "npx *": "deny",
      "yarn add*": "ask",
      "yarn remove*": "ask",
      "yarn upgrade*": "ask"
    }
  }
}
